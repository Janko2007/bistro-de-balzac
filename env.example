# Kopiraj ovaj fajl u `.env` i popuni vrednostima iz Supabase projekta:
# Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Naziv lokala koji se prikazuje u zaglavlju aplikacije (opciono)
VITE_APP_NAME=Bistro de Balzac

# Radnici se prijavljuju punim imenom. Supabase Auth traži email, pa ga
# aplikacija generiše: "Marko Marković" -> marko.markovic@<domen>.
# Domen nikad ne vidi radnik i na njega se ništa ne šalje.
# VAŽNO: ista vrednost mora da stoji i u Edge Funkciji (Supabase ->
# Edge Functions -> manage-worker -> Secrets -> LOGIN_DOMAIN).
VITE_LOGIN_DOMAIN=bistrodebalzac.rs
